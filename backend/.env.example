# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://seo_user:seo_password@localhost:5432/seo_analyzer
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=seo_user
DATABASE_PASSWORD=seo_password
DATABASE_NAME=seo_analyzer

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# External APIs
SERPAPI_KEY=your_serp_api_key_for_keyword_research
GOOGLE_API_KEY=your_google_api_key

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
